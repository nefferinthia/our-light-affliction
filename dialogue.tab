endings_c72231fb	e	What are we going to do about the boundary?	game/script.rpy	3981	e beyond neutral "[what]"
endings_d0b03ba4	extend e	 You know something I don’t, don’t you?	game/script.rpy	3983	extend "[what]"
endings_87052104	l	Hmm..?	game/script.rpy	3986	l "[what]"
